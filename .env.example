# macOS Code Signing & Notarization
# ==================================
# Copy this file to .env and fill in your values

# Your signing certificate name (find with: security find-identity -v -p codesigning)
# Example: "Developer ID Application: John Doe (ABC123XYZ)"
APPLE_SIGNING_IDENTITY=""

# For notarization (required for --notarize flag)
# Your Apple ID email
APPLE_ID=""

# App-specific password (create at https://appleid.apple.com/account/manage -> App-Specific Passwords)
APPLE_PASSWORD=""

# Your Apple Developer Team ID (find in https://developer.apple.com/account -> Membership)
APPLE_TEAM_ID=""
