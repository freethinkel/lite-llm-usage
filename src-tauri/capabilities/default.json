{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "nspopover:allow-show-popover",
    "nspopover:allow-hide-popover",
    "nspopover:allow-is-popover-shown",
    "core:tray:allow-new",
    "core:tray:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**/*", "$HOME/.claude/**/*"]
    },
    "http:default",
    { "identifier": "http:allow-fetch", "allow": ["https://*"] }
  ]
}
